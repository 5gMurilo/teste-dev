# Todas as variáveis abaixo são lidas APENAS pelo servidor SSR (Hono).
# Nenhuma variável VITE_ existe neste projeto: o browser nunca conhece o endereço da API.

# Ambiente de execução. Metade do gate de dev tools.
NODE_ENV=development

# Porta do servidor SSR.
PORT=3000

# Endereço de bind (0.0.0.0 é necessário dentro de containers).
HOST=0.0.0.0

# Base da API NestJS. Server-only: nunca é exposta ao browser.
API_BASE_URL=http://localhost:8000/api/v1

# Timeout (ms) aplicado a cada chamada de proxy para a API.
API_TIMEOUT_MS=5000

# Opt-in explícito das ferramentas de desenvolvimento.
# Ativo somente quando o valor é exatamente "true" E NODE_ENV != production.
DEV_TOOLS_ENABLED=false

# Máximo de linhas de log retidas no drawer de dev.
DEV_LOGS_CLIENT_LIMIT=500

# Força o servidor a usar o bundle já compilado em dist/ mesmo com
# NODE_ENV=development (usado na imagem Docker, onde não há Vite instalado).
# Valores: "prebuilt" ou ausente.
SSR_MODE=
