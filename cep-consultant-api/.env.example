NODE_ENV=development
PORT=8000

BRASIL_API_PROVIDER_BASE_URL=https://brasilapi.com.br/api/cep/v1/
BRASIL_API_TIMEOUT_MS=2000

VIA_CEP_PROVIDER_BASE_URL=https://viacep.com.br/ws/
VIA_CEP_TIMEOUT_MS=2000

REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=604800
REDIS_GRACE_SECONDS=86400
REDIS_LOCK_TTL_MS=4000

CONCURRENCY_LIMIT=10

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Comma-separated list of allowed CORS origins. Unset means "*".
CORS_ORIGIN=

# Dev log viewer. Opt-in only: the GET /api/v1/dev-logs endpoint exists solely
# when DEV_TOOLS_ENABLED=true AND NODE_ENV is not "production".
DEV_TOOLS_ENABLED=false
# Max number of log records retained in the in-memory ring buffer.
DEV_LOGS_BUFFER_SIZE=500
